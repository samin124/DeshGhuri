{
  "name": "DeshGhuri",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "typescript": "^5",
      "@types/bun": "^1.3.4",
      "better-auth": "^1.4.9",
      "resend": "^4.1.0",
      "nodemailer": "^6.9.14",
      "@types/nodemailer": "^6.4.16"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "build": "bun run --filter '*' build",
    "check-types": "bun run --filter '*' check-types",
    "dev:native": "bun run --filter native dev",
    "dev:web": "bun run --filter web dev",
    "dev:server": "bun run --filter server dev",
    "db:push": "bun run --filter @DeshGhuri/db db:push",
    "db:studio": "bun run --filter @DeshGhuri/db db:studio",
    "db:generate": "bun run --filter @DeshGhuri/db db:generate",
    "db:migrate": "bun run --filter @DeshGhuri/db db:migrate",
    "db:seed": "cd apps/server && bun run src/scripts/seed-comprehensive-data.ts",
    "db:seed-listings": "cd apps/server && bun run src/scripts/seed-listings.ts",
    "db:seed-roles": "bun run --filter @DeshGhuri/db db:seed-roles",
    "db:reset": "bun run db:migrate && bun run db:seed",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "prepare": "husky"
  },
  "dependencies": {
    "@DeshGhuri/env": "workspace:*",
    "@hono/zod-validator": "^0.7.6",
    "@node-rs/argon2": "^2.0.2",
    "@radix-ui/react-slider": "^1.3.6",
    "dotenv": "catalog:",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "recharts": "^3.7.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@DeshGhuri/config": "workspace:*",
    "@types/bun": "catalog:",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "^3.8.1",
    "typescript": "catalog:"
  },
  "lint-staged": {
    "**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,vue,astro,svelte}": ""
  },
  "packageManager": "bun@1.3.6"
}
